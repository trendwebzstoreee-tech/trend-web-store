# Copy this to .env and set your own private values. Never upload .env to GitHub.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000


# ---- Email OTP + order-confirmed emails ----
# console = testing only (prints the OTP in the server log) | brevo = free, works on Render free | smtp = Gmail etc. (blocked on Render free)
EMAIL_PROVIDER=console
EMAIL_FROM=
BREVO_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# OTP is only required at sign-up. Leave this false so returning customers log in with email + password only.
LOGIN_OTP=false
# Public address of your store (added to the confirmation email)
PUBLIC_URL=https://trend-web-store.onrender.com

# ---- MongoDB Atlas (permanent storage for products, settings, orders, customers and uploaded images) ----
# Include a database name after the host, e.g. ...mongodb.net/trendstore?retryWrites=true&w=majority
MONGO_URI=
